PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/pathpilot?retryWrites=true&w=majority&appName=Cluster0

# Groq API key - keep only in backend env
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JWT secret for login/signup tokens
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend URLs allowed to call backend
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
